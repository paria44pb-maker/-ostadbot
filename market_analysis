async def market_analysis(update: Update, context: ContextTypes.DEFAULT_TYPE):

    msg_obj = update.message if update.message else update.callback_query.message

    data = requests.get(
        "https://api.coingecko.com/api/v3/global"
    ).json()

    cap = data["data"]["total_market_cap"]["usd"]
    btc_dom = data["data"]["market_cap_percentage"]["btc"]

    msg = f"""
🧠 تحلیل سریع بازار

ارزش کل بازار:
{cap:,.0f} $

Dominance BTC:
{btc_dom:.2f} %

دامیننس بالا یعنی پول بیشتر در بیت‌کوین است.
"""

    await msg_obj.reply_text(msg)
