import os
import requests

API_KEY = os.getenv("NOBITEX_API_KEY")

HEADERS = {
    "Authorization": f"Token {API_KEY}"
}

BASE_URL = "https://api.nobitex.ir"

def get_balance():
    try:
        url = f"{BASE_URL}/users/wallets/list"

        response = requests.get(
            url,
            headers=HEADERS
        )

        print("STATUS:", response.status_code)
        print("RESPONSE:", response.text)

        data = response.json()

        if response.status_code != 200:
            return None

        wallets = data.get("wallets", [])

        result = {}

        for wallet in wallets:
            currency = wallet.get("currency")
            balance = wallet.get("balance")

            if float(balance) > 0:
                result[currency] = balance

        return result

    except Exception as e:
        print("BALANCE ERROR:", e)
        return None


def get_market_price(symbol="BTCUSDT"):
    try:

        src = symbol.replace("USDT", "").lower()

        url = f"{BASE_URL}/market/stats"

        payload = {
            "srcCurrency": src,
            "dstCurrency": "usdt"
        }

        response = requests.post(url, json=payload)

        print("PRICE STATUS:", response.status_code)
        print("PRICE RESPONSE:", response.text)

        data = response.json()

        pair = f"{src}-usdt"

        return data["stats"][pair]["latest"]

    except Exception as e:
        print("PRICE ERROR:", e)
        return None


def place_order(side, symbol, amount):

    try:

        src = symbol.replace("USDT", "").lower()

        url = f"{BASE_URL}/market/orders/add"

        payload = {
            "type": side,
            "srcCurrency": src,
            "dstCurrency": "usdt",
            "amount": str(amount),
            "execution": "market"
        }

        response = requests.post(
            url,
            headers=HEADERS,
            json=payload
        )

        print("ORDER STATUS:", response.status_code)
        print("ORDER RESPONSE:", response.text)

        return response.json()

    except Exception as e:
        print("ORDER ERROR:", e)
        return None
