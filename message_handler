async def message_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):

    global client_groq, client_deepseek

    from datetime import datetime
    import pytz

    if not update.message or not update.message.text:
        return

    user_text = update.message.text
    user_id = update.effective_user.id

    # ---------- TIME ----------
    try:
        tehran = pytz.timezone("Asia/Tehran")
        now = datetime.now(tehran)
    except:
        now = datetime.utcnow()

    current_time = now.strftime("%H:%M:%S")
    current_date = now.strftime("%Y-%m-%d")
    weekday_en = now.strftime("%A")

    days = {
        "Monday": "دوشنبه",
        "Tuesday": "سه‌شنبه",
        "Wednesday": "چهارشنبه",
        "Thursday": "پنجشنبه",
        "Friday": "جمعه",
        "Saturday": "شنبه",
        "Sunday": "یکشنبه"
    }

    weekday_fa = days.get(weekday_en, weekday_en)

    # ---------- MEMORY ----------
    history = get_chat_history(user_id)

    # ---------- SYSTEM PROMPT ----------
    system_prompt = f"""
تو یک دستیار هوش مصنوعی فارسی هستی.

زمان فعلی ایران:
ساعت: {current_time}
تاریخ: {current_date}
روز: {weekday_fa}

اگر کاربر درباره زمان پرسید از این اطلاعات استفاده کن.
"""

    messages = [{"role": "system", "content": system_prompt}]
    messages.extend(history)
    messages.append({"role": "user", "content": user_text})

    reply = None

    # ---------- GROQ ----------
    if client_groq:
        try:
            completion = client_groq.chat.completions.create(
                model="llama-3.3-70b-versatile",
                messages=messages
            )
            reply = completion.choices[0].message.content
        except Exception as e:
            logger.error(f"Groq error: {e}")

    # ---------- DEEPSEEK ----------
    if not reply and client_deepseek:
        try:
            completion = client_deepseek.chat.completions.create(
                model="deepseek-chat",
                messages=messages
            )
            reply = completion.choices[0].message.content
        except Exception as e:
            logger.error(f"DeepSeek error: {e}")

    if not reply:
        reply = "⚠️ خطا در اتصال به مدل هوش مصنوعی"

    save_chat(user_id, "user", user_text)
    save_chat(user_id, "assistant", reply)

    await update.message.reply_text(reply)
