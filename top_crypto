async def top_crypto(query, context):

    await query.answer()
    msg = query.message

    url = "https://farhad-proxy.vercel.app/api/nobitex-proxy?endpoint=market/stats"

    try:
        response = requests.get(url, timeout=15)
        data = response.json()
    except Exception as e:
        print("Proxy Error:", e)
        await msg.reply_text("❌ خطا در ارتباط پراکسی نوبیتکس")
        return

    if not data or "stats" not in data:
        await msg.reply_text("❌ نوبیتکس پاسخی برنگرداند.")
        return

    stats = data["stats"]

    sorted_list = sorted(
        stats.items(),
        key=lambda x: float(x[1].get("dayVolume", 0)),
        reverse=True
    )[:10]

    result = "🔥 ۱۰ ارز برتر بازار (از نوبیتکس) 🔥\n\n"

    for symbol, info in sorted_list:
        price = info.get("latest", "—")
        volume = info.get("dayVolume", "—")
        result += f"• {symbol.upper()} → قیمت: {price} — حجم: {volume}\n"

    await msg.reply_text(result)
