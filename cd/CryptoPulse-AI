"""Utility Functions"""
import re
from typing import Optional

def extract_symbol(text: str) -> Optional[str]:
    """Extract trading symbol from text"""
    patterns = [
        r'(BTC|ETH|SOL|BNB|XRP|ADA|DOGE|DOT|MATIC|AVAX)(?:/|\s)*(USDT|USD|IRT)?',
        r'(بیت کوین|بیت‌کوین|اتریوم|سولانا|بایننس)',
    ]
    for pattern in patterns:
        match = re.search(pattern, text, re.IGNORECASE)
        if match:
            return match.group(0).upper()
    return None

def format_price(price: float, decimals: int = 4) -> str:
    """Format price with commas"""
    return f"{price:,.{decimals}f}"

def format_percentage(percent: float) -> str:
    """Format percentage with color indicator"""
    emoji = "🟢" if percent > 0 else "🔴" if percent < 0 else "⚪"
    return f"{emoji} {percent:+.2f}%"

def truncate(text: str, max_len: int = 100) -> str:
    """Truncate text to max length"""
    return text[:max_len] + "..." if len(text) > max_len else text
