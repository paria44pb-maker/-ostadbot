"""Database Manager"""
import aiosqlite
import time
from typing import Optional, Dict, List, Any
from core.config import settings
from core.exceptions import DatabaseError

class Database:
    SCHEMA = """
    CREATE TABLE IF NOT EXISTS users (
        user_id INTEGER PRIMARY KEY,
