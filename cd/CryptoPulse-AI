"""Tehran Time Manager"""
from datetime import datetime, timedelta, timezone
from typing import Dict

class TehranTime:
    TEHRAN_OFFSET = timedelta(hours=3, minutes=30)
    
    MONTHS = ["فروردین","اردیبهشت","خرداد","تیر","مرداد","شهریور",
              "مهر","آبان","آذر","دی","بهمن","اسفند"]
    
    DAYS = ["دوشنبه","سه‌شنبه","چهارشنبه","پنج‌شنبه","جمعه","شنبه","یکشنبه"]
    
    @classmethod
    def now(cls) -> datetime:
        return datetime.now(timezone.utc) + cls.TEHRAN_OFFSET
    
    @classmethod
    def now_ts(cls) -> float:
        return cls.now().timestamp()
    
    @classmethod
    def format(cls, dt: datetime = None, fmt: str = "full") -> str:
        if dt is None: dt = cls.now()
        
        if fmt == "full":
            return f"{cls.DAYS[dt.weekday()]} {cls._day(dt)} {cls.MONTHS[cls._month(dt)-1]} {cls._year(dt)} - {dt.strftime('%H:%M:%S')}"
        elif fmt == "time":
            return dt.strftime("%H:%M:%S")
        elif fmt == "date":
            return f"{cls._day(dt)} {cls.MONTHS[cls._month(dt)-1]} {cls._year(dt)}"
        elif fmt == "short":
            return f"{cls._year(dt)}/{cls._month(dt):02d}/{cls._day(dt):02d} - {dt.strftime('%H:%M')}"
        elif fmt == "relative":
            diff = cls.now() - dt
            s = int(diff.total_seconds())
            if s < 60: return f"{s} ثانیه پیش"
            elif s < 3600: return f"{s//60} دقیقه پیش"
            elif s < 86400: return f"{s//3600} ساعت پیش"
            elif s < 604800: return f"{s//86400} روز پیش"
            return cls.format(dt, "date")
        return dt.strftime("%Y-%m-%d %H:%M:%S")
    
    @classmethod
    def _year(cls, dt): return dt.year - 621 if (dt.month, dt.day) >= (3,21) else dt.year - 622
    @classmethod
    def _month(cls, dt):
        s = datetime(dt.year,3,21,tzinfo=dt.tzinfo) if (dt.month,dt.day)>=(3,21) else datetime(dt.year-1,3,21,tzinfo=dt.tzinfo)
        d = (dt-s).days
        for i,md in enumerate([31,31,31,31,31,31,30,30,30,30,30,29]):
            if d < md: return i+1
            d -= md
        return 12
    @classmethod
    def _day(cls, dt):
        s = datetime(dt.year,3,21,tzinfo=dt.tzinfo) if (dt.month,dt.day)>=(3,21) else datetime(dt.year-1,3,21,tzinfo=dt.tzinfo)
        d = (dt-s).days
        for md in [31,31,31,31,31,31,30,30,30,30,30,29]:
            if d < md: return d+1
            d -= md
        return 29
    
    @classmethod
    def get_season(cls, dt=None):
        if dt is None: dt = cls.now()
        m = cls._month(dt)
        if m <= 3: return "بهار 🌸"
        elif m <= 6: return "تابستان ☀️"
        elif m <= 9: return "پاییز 🍂"
        return "زمستان ❄️"
    
    @classmethod
    def is_weekend(cls, dt=None):
        if dt is None: dt = cls.now()
        return dt.weekday() == 4
    
    @classmethod
    def trading_session(cls, dt=None):
        if dt is None: dt = cls.now()
        h = dt.hour
        if 3 <= h < 12: return "آسیا 🌏"
        elif 12 <= h < 19: return "اروپا 🌍"
        return "آمریکا 🌎"
