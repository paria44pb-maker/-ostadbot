def get_user(user_id): conn = sqlite3.connect("memory.db") cursor = conn.cursor() cursor.execute("SELECT vip, requests, last_reset FROM users WHERE user_id=?", (user_id,)) row = cursor.fetchone()

if not row:
    cursor.execute("INSERT INTO users VALUES (?, 0, 0, ?)", (user_id, int(time.time())))
    conn.commit()
    conn.close()
    return (0, 0, int(time.time()))

conn.close()
return row

def update_requests(user_id): conn = sqlite3.connect("memory.db") cursor = conn.cursor()

cursor.execute("UPDATE users SET requests = requests + 1 WHERE user_id=?", (user_id,))

conn.commit()
conn.close()

