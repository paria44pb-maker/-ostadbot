def save_message(user_id, role, content): conn = sqlite3.connect("memory.db") cursor = conn.cursor() cursor.execute("INSERT INTO messages VALUES (?, ?, ?)", (user_id, role, content)) conn.commit() conn.close()

def get_history(user_id, limit=10): conn = sqlite3.connect("memory.db") cursor = conn.cursor()

cursor.execute("""
SELECT role, content FROM messages
WHERE user_id=?
ORDER BY rowid DESC
LIMIT ?
""", (user_id, limit))

rows = cursor.fetchall()
conn.close()

return rows[::-1]

