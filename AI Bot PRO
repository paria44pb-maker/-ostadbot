def init_db(): conn = sqlite3.connect("memory.db") cursor = conn.cursor()

cursor.execute("""
CREATE TABLE IF NOT EXISTS messages (
    user_id TEXT,
    role TEXT,
    content TEXT
)
""")

cursor.execute("""
CREATE TABLE IF NOT EXISTS users (
    user_id TEXT PRIMARY KEY,
    vip INTEGER DEFAULT 0,
    requests INTEGER DEFAULT 0,
    last_reset INTEGER
)
""")

conn.commit()
conn.close()

