async def handle(update: Update, context: ContextTypes.DEFAULT_TYPE): user_id = str(update.message.chat_id) text = update.message.text

if not can_use(user_id):
    await update.message.reply_text("❌ محدودیت تمام شده. نسخه VIP بخر.")
    return

save_message(user_id, "user", text)
history = get_history(user_id)
prompt = build_prompt(history)

reply = await asyncio.to_thread(call_ai, prompt)

save_message(user_id, "assistant", reply)
update_requests(user_id)

await update.message.reply_text(reply)

